{
  "name": "gex-cockpit",
  "version": "0.2.1",
  "description": "Local GexBot gamma-exposure cockpit: NDX + QQQ charts with GEX profiles, levels, and zero-gamma history",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "bun scripts/ui-probe.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
